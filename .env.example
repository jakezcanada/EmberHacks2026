# Gemini API Key (keep server-side)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name
GEMINI_MODEL=gemini-3.6-flash

# Tried in order when the primary model is overloaded (503), out of quota (429) or slow
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash,gemini-3.7-flash

# Server port for Express proxy
PORT=3001

# Maximum duration in seconds for audio recording / processing
MAX_AUDIO_SECONDS=15

# Force using cached fallback presets (useful for offline / rehearsal)
USE_FALLBACK_ONLY=false
